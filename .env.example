# ============================================
# Binance Futures Trading Bot - Environment Config
# ============================================

# Binance API Credentials
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Trading Configuration
TRADING_SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT,BNB/USDT:USDT
TIMEFRAME=15m
DEFAULT_LEVERAGE=8
MAX_LEVERAGE=12
MIN_LEVERAGE=6

# Risk Management (0.5% - 1% por trade)
MAX_DAILY_LOSS_PCT=5.0
MAX_POSITION_PCT=10.0
STOP_LOSS_PCT=2.0
TRAILING_STOP_PCT=1.5
RISK_PER_TRADE_PCT=1.0

# Margin Mode (ISOLATED = hedge mode desativado)
MARGIN_MODE=ISOLATED

# MTF Daily Bias (Ichimoku Anchor)
DAILY_BIAS_ENABLED=true
DAILY_BIAS_KIJUN_PERIOD=26
DAILY_BIAS_MULTIPLIER_IN_CLOUD=0.5
DAILY_BIAS_COOLDOWN_CANDLES=1

# Sentiment Analysis
SENTIMENT_ENABLED=false
SENTIMENT_EXTREME_FEAR_THRESHOLD=20
SENTIMENT_EXTREME_GREED_THRESHOLD=85
SENTIMENT_CACHE_TTL_SECONDS=3600

# Strategy Parameters (Trigger Timeframe)
ICHIMOKU_TENKAN=9
ICHIMOKU_KIJUN=26
ICHIMOKU_SENKOU=52
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
ATR_PERIOD=14
WARMUP_CANDLES=100

# Circuit Breaker
CIRCUIT_BREAKER_MAX_CONSECUTIVE_LOSSES=3
CIRCUIT_BREAKER_COOLDOWN_MINUTES=30

# Dry Run (simula ordens sem executar — true por padrão para segurança)
DRY_RUN=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Application
ENVIRONMENT=production
